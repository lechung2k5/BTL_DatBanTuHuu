<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<HBox spacing="15" styleClass="root-pane" stylesheets="@../css/DatBan.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.DatBan">
   <padding> <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /> </padding>

   <VBox spacing="15" styleClass="left-panel" HBox.hgrow="NEVER" prefWidth="300.0">
      <padding> <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /> </padding>
      <HBox alignment="CENTER_LEFT" spacing="10"> <Label styleClass="screen-title-new" text="Danh sách đặt bàn" /> </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <ComboBox fx:id="comboFilter" prefWidth="120.0" promptText="Lọc..." styleClass="filter-combo-new" />
         <HBox styleClass="search-container-new" HBox.hgrow="ALWAYS"> <Label styleClass="search-icon-new" /> <TextField fx:id="txtSearch" promptText="Tìm SĐT..." styleClass="search-field-new" /> </HBox>
      </HBox>
      <ScrollPane fitToWidth="true" styleClass="card-scroll-pane" VBox.vgrow="ALWAYS">
         <content> <VBox fx:id="vboxBookingCards" spacing="15" /> </content>
      </ScrollPane>
   </VBox>

   <ScrollPane fx:id="middleScrollPane" fitToWidth="true" styleClass="middle-scroll-pane" HBox.hgrow="ALWAYS">
      <content>
         <VBox spacing="15">
             <HBox spacing="10" alignment="CENTER_LEFT" styleClass="time-filter-container">
                  <Label text="Thời gian đến"/> <TextField fx:id="txtThoiGian" prefWidth="60.0" promptText="HH:mm" />
                  <DatePicker fx:id="datePickerThoiGianDen" prefWidth="110.0" promptText="Chọn ngày"/> <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnTim" text="Tìm bàn trống" styleClass="confirm-button"/>
             </HBox>

            <VBox styleClass="table-grid-container" spacing="10">
               <Label styleClass="form-title" text="Sơ Đồ Bàn" alignment="CENTER" maxWidth="Infinity"/>
               <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 10 0 10 0; -fx-border-color: #ced4da; -fx-border-width: 1 0 1 0;">
                   <HBox spacing="10"> <Label text="Bàn đang chọn:" style="-fx-font-weight: bold;"/> <Label fx:id="lblBanDangChon" text="Chưa chọn" style="-fx-font-weight: bold; -fx-text-fill: #2f9e44;"/> <Region HBox.hgrow="ALWAYS" /> <Label text="Trạng thái:" /> <Label fx:id="lblTrangThaiBan" text="---" /> </HBox>
               </VBox>
               <HBox alignment="CENTER" spacing="20">
                  <VBox alignment="TOP_CENTER" spacing="10"> <Label text="Tầng trệt" styleClass="floor-title"/> <GridPane fx:id="gridTangTret" hgap="10" vgap="10" /> </VBox>
                  <Region styleClass="vertical-divider" />
                  <VBox alignment="TOP_CENTER" spacing="10"> <Label text="Tầng 1" styleClass="floor-title"/> <GridPane fx:id="gridTang1" hgap="10" vgap="10" /> <Label text="Phòng riêng" styleClass="floor-title"/> <GridPane fx:id="gridPhongRieng" hgap="10" vgap="10" /> </VBox>
               </HBox>
               <HBox alignment="CENTER" spacing="15" style="-fx-padding: 15 0 0 0;">
                   <HBox alignment="CENTER" spacing="5"> <Rectangle fill="WHITE" height="20.0" styleClass="legend-box" width="20.0" /> <Label text="Bàn trống" /> </HBox>
                   <HBox alignment="CENTER" spacing="5"> <Rectangle fill="#ff8a80" height="20.0" styleClass="legend-box, booked" width="20.0" /> <Label text="Đã đặt" /> </HBox>
                   <HBox alignment="CENTER" spacing="5"> <Rectangle fill="#ffe57f" height="20.0" styleClass="legend-box, serving" width="20.0" /> <Label text="Đang dùng" /> </HBox>
                   <HBox alignment="CENTER" spacing="5"> <Rectangle fill="#b9f6ca" height="20.0" styleClass="legend-box, selected" width="20.0" /> <Label text="Đang chọn" /> </HBox>
               </HBox>
                <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;"> <Button fx:id="btnXacNhanBan" mnemonicParsing="false" text="Xác Nhận Bàn Đã Chọn" styleClass="confirm-button-large" /> </HBox>
            </VBox>

            <VBox styleClass="info-form-container" spacing="10">
               <Label styleClass="form-title" text="Thông Tin Đặt Bàn" />
               <VBox spacing="10.0">
                     <HBox spacing="15.0">
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS"> <Label text="Số điện thoại (*)" /> <TextField fx:id="txtSoDienThoai" promptText="Nhập SĐT..." /> </VBox>
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS"> <Label text="Tên khách hàng" /> <TextField fx:id="txtTenKhachHang" promptText="Tên (Nếu có)..." /> </VBox>
                     </HBox>
                     <HBox spacing="15.0">
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS"> <Label text="Số lượng người" /> <TextField fx:id="txtSoLuongKhach" promptText="VD: 8" /> </VBox>
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS"> <Label text="Yêu cầu đặc biệt" /> <TextField fx:id="txtYeuCau" promptText="Yêu cầu về bàn ăn,..." /> </VBox>
                     </HBox>
                     <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS"> <Label text="Tiền cọc bàn (tự tính)" /> <TextField fx:id="txtTienCoc" promptText="0 VNĐ" editable="false" /> </VBox>
                     </HBox>
               </VBox>
            </VBox>

            <VBox styleClass="order-container" spacing="8">
                <Label styleClass="form-title" text="Gọi Món"/>
                 <HBox alignment="CENTER_LEFT" spacing="10"> <Label styleClass="section-title-goimon" text="Danh mục món" /> <Region HBox.hgrow="ALWAYS"/> <HBox styleClass="order-search-bar"> <Label styleClass="search-icon-new"/> <TextField fx:id="txtTimMon" promptText="Tìm món..."/> </HBox> </HBox>
                 <ScrollPane fitToWidth="true">
                    <HBox fx:id="hboxDanhMucToggles" styleClass="menu-tabs" spacing="5"> <ToggleButton fx:id="toggleKhaiVi" text="Khai vị" selected="true"/> <ToggleButton fx:id="toggleNuong" text="Nướng" /> <ToggleButton fx:id="toggleLau" text="Lẩu" /> <ToggleButton fx:id="toggleXaoHap" text="Xào/Hấp" /> <ToggleButton fx:id="toggleChien" text="Chiên" /> <ToggleButton fx:id="toggleDacSan" text="Đặc sản" /> <ToggleButton fx:id="toggleDoUong" text="Đồ uống" /> </HBox>
                 </ScrollPane>
                 <TableView fx:id="tblMonAn" prefHeight="200.0">
                     <columns> <TableColumn fx:id="colHinhAnh" text="Ảnh" prefWidth="60"/> <TableColumn fx:id="colTenMon" text="Tên Món" prefWidth="150"/> <TableColumn fx:id="colGia" text="Giá" prefWidth="80"/> <TableColumn fx:id="colChon" text="Chọn" prefWidth="60"/> </columns>
                      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                 </TableView>
                 <Label text="Danh sách món đã chọn:" styleClass="section-title-goimon"/>
                 <TableView fx:id="tblMonDaChon" prefHeight="150.0">
                     <columns> <TableColumn fx:id="colOrderTenMon" text="Tên Món" prefWidth="150"/> <TableColumn fx:id="colOrderDonGia" text="Đơn Giá" prefWidth="80"/> <TableColumn fx:id="colOrderSoLuong" text="SL" prefWidth="50"/> <TableColumn fx:id="colOrderTangGiam" text="+/-" prefWidth="70"/> <TableColumn fx:id="colOrderHuy" text="Hủy" prefWidth="50"/> </columns>
                      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                 </TableView>
                 <HBox alignment="CENTER_RIGHT" spacing="10">
                     <Button fx:id="btnLuuDatHang" text="Lưu Đặt Bàn/Món" styleClass="action-button-save"/>
                 </HBox>
            </VBox> </VBox> </content>
   </ScrollPane> <ScrollPane fx:id="vboxReceipt" fitToWidth="true" styleClass="receipt-scroll-pane" prefWidth="420" HBox.hgrow="NEVER" visible="false" managed="false">
      <content>
         <VBox spacing="10" styleClass="receipt-panel">
             <Label text="HÓA ĐƠN TẠM TÍNH" styleClass="receipt-main-title"/>
             <VBox alignment="CENTER" spacing="1"> <Label text="NHÀ HÀNG TỨ HỮU" styleClass="receipt-restaurant-name"/> <Label text="Đ/c: TT. Long Thành, Duyên Hải, Trà Vinh"/> <Label text="SĐT: 0987123456"/> </VBox>
             <Label text="CHI TIẾT THANH TOÁN" styleClass="receipt-title"/>
             <Label fx:id="lblReceiptMaHD" text="Số HĐ: HDxxxxxx"/>

             <GridPane hgap="10">
                <GridPane.columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                </GridPane.columnConstraints>
                <GridPane.rowConstraints>
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                </GridPane.rowConstraints>
                 <children>
                     <Label fx:id="lblReceiptBan" text="Bàn: ..." GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                     <Label fx:id="lblReceiptThuNgan" text="Thu ngân: ..." GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                     <Label fx:id="lblReceiptGioVao" text="Giờ vào: ..." GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                     <Label fx:id="lblReceiptGioRa" text="Giờ ra: ..." GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                 </children>
             </GridPane>

             <TableView fx:id="tblHoaDonReceipt" prefHeight="250.0">
                 <columns> <TableColumn fx:id="colReceiptSTT" text="STT" prefWidth="30"/><TableColumn fx:id="colReceiptTenMon" text="Tên món" prefWidth="110"/><TableColumn fx:id="colReceiptSL" text="SL" prefWidth="30"/><TableColumn fx:id="colReceiptDonGia" text="Đơn giá" prefWidth="90"/><TableColumn fx:id="colReceiptThanhTien" text="Thành tiền" prefWidth="100"/> </columns>
                 <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
             </TableView>
             <VBox spacing="4" styleClass="receipt-summary">
			     <HBox><Label text="Tổng cộng món ăn:" styleClass="receipt-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTongTienMonAn" text="0 Đ"/></HBox>
			     <HBox><Label text="Phí dịch vụ (5%):" styleClass="receipt-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblPhiDichVu" text="0 Đ"/></HBox>
			     <HBox><Label text="Thuế VAT (8%):" styleClass="receipt-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblThueVAT" text="0 Đ"/></HBox>
			     <HBox><Label text="Tiền đặt cọc:" styleClass="receipt-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTienCocSummary" text="0 Đ"/></HBox>
			</VBox>
			<VBox spacing="8">
                 <Label text="Khuyến mãi:" styleClass="receipt-title"/>
                 <ComboBox fx:id="promoComboBox" prefWidth="Infinity" styleClass="promo-combo-box" />
			     <HBox><Label text="Khuyến mãi:" styleClass="receipt-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblKhuyenMai" text="0 Đ"/></HBox>
			</VBox>
			<HBox styleClass="receipt-total">
			    <Label text="Tổng tiền thanh toán:" styleClass="receipt-total-label"/> <Region HBox.hgrow="ALWAYS"/> <Label fx:id="lblTongTienThanhToan" text="0 Đ" styleClass="receipt-total-value"/>
			</HBox>
            <Label text="CHỌN PHƯƠNG THỨC THANH TOÁN" styleClass="receipt-title" alignment="CENTER"/>
			<HBox spacing="10" alignment="CENTER">
                 <ToggleButton fx:id="btnTienMat" text="Tiền Mặt" styleClass="payment-method-button, cash"/>
                 <ToggleButton fx:id="btnNganHang" text="Ngân Hàng" styleClass="payment-method-button, bank"/>
                 <ToggleButton fx:id="btnMoMo" text="Ví Điện Tử" styleClass="payment-method-button, momo"/>
             </HBox>
             <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                 <Button fx:id="btnXacNhanThanhToan" text="Xác Nhận Thanh Toán" styleClass="confirm-payment-button"/>
                 <Button fx:id="btnInHoaDon" text="In Hóa Đơn" styleClass="print-button"/>
             </HBox>
         </VBox>
      </content>
    </ScrollPane> </HBox>