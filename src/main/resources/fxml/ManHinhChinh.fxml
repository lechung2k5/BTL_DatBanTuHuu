<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane fx:controller="ui.ManHinhChinh" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="top-bar" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="/images/LOGO TU HUU.png" />
                     </image>
                  </ImageView>
                  <Label text="TỨ HỮU" styleClass="logo-text" />
               </children>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <ImageView fx:id="profileImage" fitHeight="40" fitWidth="40" preserveRatio="true" styleClass="profile-image">
               <image>
                  <Image url="https://i.imgur.com/83p1Ym1.png" />
               </image>
            </ImageView>
            <VBox styleClass="user-info" alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="userNameLabel" text="Tên nhân viên" styleClass="user-name" />
                  <Label fx:id="userRoleLabel" text="Chức vụ" styleClass="user-role" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
         </padding>
      </HBox>
   </top>
   <left>
      <VBox styleClass="sidebar" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <VBox styleClass="menu-items" spacing="10.0">
               <children>
                  <Button fx:id="manHinhChinhButton" onAction="#handleManHinhChinh" text="Màn hình chính" styleClass="menu-button-active">
                     <graphic>
                        <ImageView fx:id="manHinhChinhIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconHome.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyDatBanButton" onAction="#handleQuanLyDatBan" text="Quản lý đặt bàn" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyDatBanIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconDatBan.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyThongKeButton" onAction="#handleQuanLyThongKe" text="Quản lý thống kê" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyThongKeIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconThongKe.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyThucDonButton" onAction="#handleQuanLyThucDon" text="Quản lý thực đơn" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyThucDonIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconThucDon.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyHoaDonButton" onAction="#handleQuanLyHoaDon" text="Quản lý hóa đơn" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyHoaDonIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconHoaDon.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyNhanVienButton" onAction="#handleQuanLyNhanVien" text="Quản lý nhân viên" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyNhanVienIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconNhanVien.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyKhachHangButton" onAction="#handleQuanLyKhachHang" text="Quản lý khách hàng" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyKhachHangIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconKhachHang.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyKhuyenMaiButton" onAction="#handleQuanLyKhuyenMai" text="Quản lý khuyến mãi" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyKhuyenMaiIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconKhuyenMai.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="quanLyTraCuuButton" onAction="#handleQuanLyTraCuu" text="Quản lý tra cứu" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="quanLyTraCuuIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconTraCuu.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="dangXuatButton" onAction="#handleDangXuat" text="Đăng xuất" styleClass="menu-button">
                     <graphic>
                        <ImageView fx:id="dangXuatIcon" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/icons/iconDangXuat.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
      <BorderPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>