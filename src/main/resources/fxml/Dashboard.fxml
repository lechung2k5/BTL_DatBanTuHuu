<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.canvas.Canvas?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.DashboardController" styleClass="dashboard-container" spacing="20.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <HBox alignment="TOP_LEFT" spacing="20.0">
        <children>
            <VBox spacing="10.0">
                <children>
                    <Label text="Màn hình chính" styleClass="screen-title" />
                    <VBox styleClass="cash-check-container" spacing="10.0">
                        <children>
                            <Label text="Kiểm kê tiền mặt đầu ca" styleClass="cash-check-title" />
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Nhập số tiền trong két: " />
                                    <TextField fx:id="txtSoTienKiemKe" promptText="5,000,000" />
                                    <Button text="Xác nhận" styleClass="cash-check-button" onAction="#handleCheckCash" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="15.0" alignment="TOP_RIGHT">
                <children>
                    <VBox styleClass="stats-card-dayoff">
                        <children>
                            <Label text="Số ngày nghỉ" styleClass="stats-label" />
                            <Label fx:id="lblSoNgayNghi" text="0/5 ngày" styleClass="stats-value" />
                        </children>
                    </VBox>
                    <VBox styleClass="stats-card-serving">
                        <children>
                            <Label text="Bàn đang phục vụ" styleClass="stats-label" />
                            <Label fx:id="lblBanPhucVu" text="0 bàn" styleClass="stats-value" />
                        </children>
                    </VBox>
					<VBox styleClass="stats-card-reserved">
                        <children>
                            <Label text="Bàn đặt trước" styleClass="stats-label" />
                            <Label fx:id="lblBanDatTruoc" text="0/0 bàn" styleClass="stats-value" />
                        </children>
                    </VBox>
                    <VBox styleClass="stats-card-hours">
                        <children>
                            <Label text="Tổng giờ làm" styleClass="stats-label" />
                            <Label fx:id="lblTongGioLam" text="0 giờ" styleClass="stats-value" />
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <children>
            <VBox styleClass="calendar-container" HBox.hgrow="ALWAYS" spacing="15.0">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label text="Lịch làm theo tuần" styleClass="calendar-header-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <DatePicker fx:id="datePicker" styleClass="date-picker-control" prefWidth="120.0" prefHeight="30.0" onAction="#updateCalendarFromDatePicker" />
                            <Button text="Hôm nay" onAction="#handleCurrentWeek" styleClass="calendar-nav-button" />
                            <Button text="Trước" onAction="#handlePreviousWeek" styleClass="calendar-nav-button" />
                            <Button text="Sau" onAction="#handleNextWeek" styleClass="calendar-nav-button" />
                        </children>
                    </HBox>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="calendar-scroll-pane">
                        <content>
                            <GridPane fx:id="weeklyCalendarGrid" styleClass="weekly-calendar-grid" hgap="10.0" vgap="10.0" />
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <VBox styleClass="new-features-container" HBox.hgrow="ALWAYS" spacing="15.0">
                <children>
                    <VBox styleClass="table-map-container" spacing="10.0">
                        <Label text="Bàn ăn đang phục vụ" styleClass="section-title-small" />
                        <GridPane fx:id="tableMapGrid" styleClass="table-map-grid" hgap="10.0" vgap="10.0" />
                    </VBox>

                    <VBox styleClass="kpi-container" spacing="10.0">
                        <Label text="KPI cá nhân" styleClass="section-title" />
                        <HBox spacing="20.0" alignment="CENTER">
                            <VBox alignment="CENTER" spacing="5.0">
                                <Canvas fx:id="hoursCanvas" width="150" height="150" />
                                <Label fx:id="hoursDetailsLabel" styleClass="kpi-detail-label" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="5.0">
                                <Canvas fx:id="revenueCanvas" width="150" height="150" />
                                <Label fx:id="revenueDetailsLabel" styleClass="kpi-detail-label" />
                            </VBox>
                        </HBox>
                    </VBox>
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>