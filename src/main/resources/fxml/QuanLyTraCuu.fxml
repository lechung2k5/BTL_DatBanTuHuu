<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="ui.TraCuu"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-image: url('/images/background.jpg');
             -fx-background-size: cover;
             -fx-background-position: center center;
             -fx-background-repeat: no-repeat;"
      styleClass="tra-cuu-container">


    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-section">
        <children>
            <Label text="Tra cứu" styleClass="screen-title"/>
            <Region HBox.hgrow="ALWAYS"/>

        </children>
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>
    </HBox>

    <!-- Container chính với 2 phần bằng nhau -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- ========== PHẦN BÊN TRÁI - HÓA ĐƠN ========== -->
        <VBox spacing="15" styleClass="section-container" prefWidth="600" HBox.hgrow="ALWAYS">
            
            <!-- Header Hóa đơn -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-header">
                <children>
                    <Label text="Hóa đơn" styleClass="section-title"/>
                    
                    <!-- ComboBox sắp xếp -->
                    <ComboBox fx:id="cboSapXepHD" 
                              promptText="Theo ngày, theo tháng..."
                              styleClass="sort-combo"
                              prefWidth="180">
                        <HBox.margin>
                            <Insets left="10"/>
                        </HBox.margin>
                    </ComboBox>
                    
                    <!-- Search Box -->
                    <HBox alignment="CENTER_LEFT" styleClass="search-box-inline" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="🔍" style="-fx-font-size: 14px;">
                                <HBox.margin>
                                    <Insets left="10" right="8"/>
                                </HBox.margin>
                            </Label>
                            <TextField fx:id="txtTimKiemHD" 
                                      promptText="Nhập số điện thoại..."
                                      styleClass="search-field-inline"
                                      HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <!-- Bảng Hóa đơn -->
<TableView fx:id="tblHoaDon" styleClass="result-table" VBox.vgrow="ALWAYS">
    <columns>
        <TableColumn fx:id="colMaHD" text="Mã hóa đơn" prefWidth="100" resizable="false"/>
        <TableColumn fx:id="colNgayHD" text="Ngày lập" prefWidth="90" resizable="false"/>
        <TableColumn fx:id="colHinhThuc" text="Hình thức thanh toán" prefWidth="150" resizable="false"/>
        <TableColumn fx:id="colSDTKH" text="Số điện thoại khách hàng" prefWidth="160" resizable="false"/>
        <TableColumn fx:id="colTongTien" text="Tổng tiền" prefWidth="100" resizable="false"/>
        <TableColumn fx:id="colXemChiTiet" text="Chi tiết" prefWidth="150" resizable="false"/>
    </columns>
    <placeholder>
        <Label text="Nhập số điện thoại để tìm kiếm hóa đơn" styleClass="placeholder-label"/>
    </placeholder>
</TableView>

            <!-- Nút Xuất Excel -->
            <HBox alignment="CENTER_RIGHT">
                <children>
                    <Button fx:id="btnXuatExcelHD" 
                            text="📊 Xuất Excel" 
                            styleClass="excel-button"
                            onAction="#handleXuatExcelHoaDon"/>
                </children>
            </HBox>
            
        </VBox>

        <!-- ========== PHẦN BÊN PHẢI - KHÁCH HÀNG ========== -->
        <VBox spacing="15" styleClass="section-container" prefWidth="600" HBox.hgrow="ALWAYS">
            
            <!-- Header Khách hàng -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-header">
                <children>
                    <Label text="Khách hàng" styleClass="section-title"/>
                    
                    <!-- ComboBox sắp xếp -->
                    <ComboBox fx:id="cboSapXepKH" 
                              promptText="Theo ngày, theo tháng..."
                              styleClass="sort-combo"
                              prefWidth="180">
                        <HBox.margin>
                            <Insets left="10"/>
                        </HBox.margin>
                    </ComboBox>
                    
                    <!-- Search Box -->
                    <HBox alignment="CENTER_LEFT" styleClass="search-box-inline" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="🔍" style="-fx-font-size: 14px;">
                                <HBox.margin>
                                    <Insets left="10" right="8"/>
                                </HBox.margin>
                            </Label>
                            <TextField fx:id="txtTimKiemKH" 
                                      promptText="Nhập số điện thoại..."
                                      styleClass="search-field-inline"
                                      HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <!-- Bảng Khách hàng -->
            <TableView fx:id="tblKhachHang" styleClass="result-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMaKH" text="Mã khách hàng" prefWidth="110" resizable="false"/>
                    <TableColumn fx:id="colHoTen" text="Họ và tên" prefWidth="120" resizable="false"/>
                    <TableColumn fx:id="colSDT" text="Số điện thoại" prefWidth="110" resizable="false"/>
                    <TableColumn fx:id="colDiaChi" text="Địa chỉ" prefWidth="80" resizable="false"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="150" resizable="false"/>
                    <TableColumn fx:id="colNgayDK" text="Ngày đăng ký" prefWidth="100" resizable="false"/>
                    <TableColumn fx:id="colLoaiKH" text="Loại khách hàng" prefWidth="115" resizable="false"/>
                    <TableColumn fx:id="colTongTienHD" text="Tổng tiền hóa đơn" prefWidth="130" resizable="false"/>
                    <TableColumn fx:id="colLichSu" text="Lịch sử" prefWidth="80" resizable="false"/>
                </columns>
                <placeholder>
                    <Label text="Nhập số điện thoại để tìm kiếm khách hàng" styleClass="placeholder-label"/>
                </placeholder>
            </TableView>

            <!-- Nút Xuất Excel -->
            <HBox alignment="CENTER_RIGHT">
                <children>
                    <Button fx:id="btnXuatExcelKH" 
                            text="📊 Xuất Excel" 
                            styleClass="excel-button"
                            onAction="#handleXuatExcelKhachHang"/>
                </children>
            </HBox>
            
        </VBox>
        
    </HBox>

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

</VBox>