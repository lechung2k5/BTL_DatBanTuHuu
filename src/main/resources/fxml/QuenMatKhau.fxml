<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="ui.QuenMatKhau" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="quen-mat-khau-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="Quên mật khẩu" styleClass="form-title" />
        <Label text="Vui lòng nhập mã nhân viên của bạn để đặt lại mật khẩu." />
        
        <TextField fx:id="txtMaNhanVien" promptText="Mã nhân viên" styleClass="text-field" />
        
        <Button text="Xác nhận" onAction="#handleXacNhan" styleClass="action-button" />
        
        <Button text="Quay lại" onAction="#handleQuayLai" styleClass="link-button" />
    </children>
    <padding>
        <Insets top="50" right="50" bottom="50" left="50" />
    </padding>
</VBox>