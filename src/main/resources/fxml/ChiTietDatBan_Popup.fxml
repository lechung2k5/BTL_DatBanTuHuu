<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootVBox" prefHeight="750.0" prefWidth="950.0" spacing="15.0" styleClass="popup-container" stylesheets="@../css/DatBan.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.ChiTietDatBanController">
   <children>
      <VBox styleClass="section-card" spacing="10.0">
         <children>
            <Label fx:id="lblMaHD" text="Chi tiết đặt bàn HDxxxxxx">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
        
    <Label text="Thông tin đặt bàn">
               <font><Font name="System Bold" size="14.0" /></font>
            </Label>
            
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                  
<children>
                     <Label text="Tên khách hàng" styleClass="form-label" />
                     <TextField fx:id="txtTenKhachHang" promptText="Anh Nam" />
                     <Label text="Số lượng người" styleClass="form-label" />
                     <TextField fx:id="txtSoLuongKhach" 
promptText="8" />
                  </children>
               </VBox>
               <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                  <children>
                     <Label text="Số điện thoại" styleClass="form-label" />
     
                <TextField fx:id="txtSoDienThoai" promptText="0377019958" />
                     <Label text="Thời gian đến" styleClass="form-label" />
                     <HBox spacing="5.0">
                        <TextField fx:id="txtThoiGian" prefWidth="60.0" promptText="18:00" />
     
                   <DatePicker fx:id="datePickerThoiGianDen" HBox.hgrow="ALWAYS" />
                     </HBox>
                  </children>
               </VBox>
               <VBox HBox.hgrow="ALWAYS" spacing="10.0">
       
           <children>
                     <Label text="Yêu cầu đặc biệt" styleClass="form-label" />
                     <TextField fx:id="txtYeuCau" promptText="phòng riêng/bàn tầng trệt" />
                     <Label text="Bàn (Mã)" styleClass="form-label" />
          
           <HBox spacing="10.0">
                        <TextField fx:id="txtMaBan" promptText="B023" />
                        <Label text="Trạng thái:" />
                        <ComboBox fx:id="comboTrangThai" prefWidth="150.0" promptText="Đang phục vụ" />
    
                 </HBox>
                  </children>
               </VBox>
            </HBox>
            
			<HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="NEVER">
			    <children>
			        <Button fx:id="btnBack" mnemonicParsing="false" styleClass="btn-secondary" text="&lt; Quay lại" />
			        <Region HBox.hgrow="ALWAYS" />
			        <Button fx:id="btnCapNhat" mnemonicParsing="false" styleClass="btn-primary" text="Cập nhật" /> 
			    </children>
			    <VBox.margin>
			        <Insets top="10.0" />
			    </VBox.margin>
			</HBox>
         </children>
     
    <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0" /></padding>
      </VBox>

      <StackPane fx:id="contentContainer" VBox.vgrow="ALWAYS" styleClass="section-card">
         </StackPane>

   </children>
   <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
</VBox>