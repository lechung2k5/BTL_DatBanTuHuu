<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="ui.ThongKe" styleClass="thong-ke-container" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <Label text="Quản lý thống kê" styleClass="screen-title" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox styleClass="chart-container" HBox.hgrow="ALWAYS">
            <children>
                <Label text="Biểu đồ doanh thu" styleClass="chart-title" />
                </children>
        </VBox>
        
        <VBox spacing="10.0" styleClass="data-container">
            <children>
                <Label text="Thống kê theo tháng" styleClass="data-title" />
                <GridPane hgap="10.0" vgap="10.0">
                    <children>
                        <Label text="Tổng doanh thu:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <Label fx:id="lblTongDoanhThu" text="100,000,000 VNĐ" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                        
                        <Label text="Số lượng đơn hàng:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <Label fx:id="lblSoLuongDon" text="500" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    </children>
                </GridPane>
            </children>
        </VBox>
    </HBox>
</VBox>